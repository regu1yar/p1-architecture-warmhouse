@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
' !include ../common/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component diagram for Warmhouse system - Monitoring Service

Container(connections_service, "Connections Service", "Service for 2-way interaction with devices")
Container(scenarios_api, "Scenarios API", "Provides API for managing and inferring scenarios")
Container(device_state_storage_api, "Device State Storage API", "Provides API for storing and retrieving device states")
Container(realtime_service, "Realtime Service", "Delivers real-time device state updates")
ContainerDb(monitoring_subscriptions_db, "Monitoring Subscriptions DB", "Key-Value Store", "Stores subscriptions for device state updates")

Container_Boundary(monitoring_service, "Monitoring Service") {
    Component(state_update_consumer, "State Update Consumer", "Kafka Consumer", "Consumes device state updates from message queue")
    Component(subscription_manager, "Subscription Manager", "Go Service", "Manages subscriptions for device state updates")
    Component(notification_dispatcher, "Notification Dispatcher", "Go Service", "Dispatches updates to subscribed services")
    Component(state_processor, "State Processor", "Go Library", "Processes and filters device state updates")

    Rel(state_update_consumer, state_processor, "Passes updates to", "Internal message queue")
    Rel(state_processor, subscription_manager, "Checks subscriptions via", "Internal API")
    Rel(state_processor, notification_dispatcher, "Sends notifications via", "Internal API")
    Rel(notification_dispatcher, scenarios_api, "Sends updates to", "async, JSON/HTTPS")
    Rel(notification_dispatcher, device_state_storage_api, "Sends updates to", "async, JSON/HTTPS")
    Rel(notification_dispatcher, realtime_service, "Sends updates to", "async, JSON/HTTPS")
    Rel(subscription_manager, monitoring_subscriptions_db, "Stores/retrieves subscriptions in", "JSON/HTTPS")
    Rel(subscription_manager, state_update_consumer, "Configures consumption for", "Internal API")
}

Rel(connections_service, state_update_consumer, "Sends device state updates", "async, JSON/HTTPS")
Rel(scenarios_api, subscription_manager, "Subscribes to updates via", "JSON/HTTPS")
Rel(device_state_storage_api, subscription_manager, "Subscribes to updates via", "JSON/HTTPS")
Rel(realtime_service, subscription_manager, "Subscribes to updates via", "JSON/HTTPS")

@enduml