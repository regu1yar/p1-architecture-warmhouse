@startuml
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
' uncomment the following line and comment the first to use locally
!include ./C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component diagram for Warmhouse system - Device State Storage API

Container(spa, "Single Page Application", "javascript and angular", "Allows user to view device states via web interface")
ContainerDb(device_state_db, "Device State DB", "Time-series Database", "Stores historical device states")
Container(monitoring_service, "Monitoring Service", "Processes incoming device state updates")

Container_Boundary(device_state_storage_api, "Device State Storage API") {
    Component(state_storage_controller, "State Storage Controller", "Go REST API", "Handles device state storage and retrieval requests")
    Component(historical_data_manager, "Historical Data Manager", "Go Service", "Manages time-series data in Device State DB")
    Component(state_query_engine, "State Query Engine", "Database Client", "Queries historical states with filters and aggregations")
    Component(cache_layer, "Cache Layer", "Redis Client", "Caches recent device states for performance")

    Rel(state_storage_controller, historical_data_manager, "Stores/retrieves data via", "Internal API")
    Rel(historical_data_manager, device_state_db, "Stores historical data to", "JSON/HTTPS")
    Rel(state_storage_controller, state_query_engine, "Queries data via", "Internal API")
    Rel(state_query_engine, device_state_db, "Queries historical data from", "JSON/HTTPS")
    Rel(state_storage_controller, cache_layer, "Caches/retrieves recent states via", "Internal API")
    Rel(cache_layer, historical_data_manager, "Warms cache from", "Internal API")
}

Rel(spa, state_storage_controller, "Gets last device states via", "JSON/HTTPS")
Rel(monitoring_service, state_storage_controller, "Sends device state updates to", "sync/async, JSON/HTTPS")
Rel(state_storage_controller, monitoring_service, "Subscribes to updates via", "sync/async, JSON/HTTPS")

@enduml