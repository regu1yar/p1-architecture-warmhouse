@startuml "enterprise"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container diagram for Warmhouse smart home system

Person(user, "User", "Warmhouse user")

System_Ext(sensor, "Sensor", "Sensor for some kind of measurement in the house")
System_Ext(device, "Device", "Smart home device to be controlled")

System_Ext(partner_api, "Partner API", "Third-party API for partner devices and sensors")

Enterprise_Boundary(warmhouse_boundary, "Warmhouse") {
    Person(warmhouse_specialist, "Specialist", "Technical specialist")
    System(warmhouse_backend, "Backend", "Warmhouse backend")
}

Rel(user, warmhouse_backend, "Gets current temperature from")
Rel(user, warmhouse_backend, "Sets target temperature using")

Rel(warmhouse_specialist, sensor, "Sets up")
Rel(warmhouse_specialist, warmhouse_backend, "Registers sensors via")

Rel(warmhouse_backend, temperature_api, "Calls")

Rel(temperature_api, sensor, "Reads temperature from")

@enduml
